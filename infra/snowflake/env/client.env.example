# -----------------------------------------------------------------------------
# Client SPCS deployment environment
# Copy this file to client.env and fill in the client-specific values.
# These values are consumed by the Snow CLI / browser-auth deployment scripts:
#   - scripts/bootstrap_client_spcs_tools.sh
#   - scripts/configure_client_snow_connection.sh
#   - scripts/deploy_spcs_client_snow.sh
#   - scripts/run_client_spcs_browser_deploy.sh
# -----------------------------------------------------------------------------

# Snow CLI connection settings
SNOWFLAKE_CONNECTION=client-spcs
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_ROLE=your_deployer_role

# Warehouse / runtime namespace
SNOWFLAKE_WAREHOUSE=your_runtime_warehouse
SNOWFLAKE_DATABASE=your_runtime_database
SNOWFLAKE_SCHEMA=your_runtime_schema

# Registry — format: <org>-<account>.registry.snowflakecomputing.com
SNOWFLAKE_REGISTRY_HOST=your_org-your_account.registry.snowflakecomputing.com
SNOWFLAKE_IMAGE_REPOSITORY=your_image_repository

# Compute pool and service name
SNOWFLAKE_COMPUTE_POOL=your_compute_pool
WEBAPP_SERVICE_NAME=your_webapp_service_name

# Egress integration already created by client admin
SNOWFLAKE_EGRESS_INTEGRATION=your_egress_integration

# App runtime
APP_NAME=BBI AI Migration Workbench API
APP_ENV=client
USERS_TABLE=YOUR_DB.YOUR_SCHEMA.TBL_USERS

# Persona role mapping
APP_ROLE_ADMIN=CLIENT_ADMIN_ROLE
APP_ROLE_PUBLISHER=CLIENT_PUBLISHER_ROLE
APP_ROLE_VIEWER=CLIENT_VIEWER_ROLE

# Cortex Agent configuration
SNOWFLAKE_STTM_BUILDER_AGENT=YOUR_DB.YOUR_SCHEMA.AGT_STTM_BUILDER
SNOWFLAKE_SEMANTIC_MODEL_AGENT=YOUR_DB.YOUR_SCHEMA.AGT_SEMANTIC_MODEL
SNOWFLAKE_RELATIONSHIPS_PROCEDURE=YOUR_DB.YOUR_SCHEMA.SP_GET_TABLE_RELATIONSHIPS
SNOWFLAKE_SEMANTIC_MODEL_TABLE=YOUR_DB.YOUR_SCHEMA.TBL_SEMANTIC_MODELS
SNOWFLAKE_DERIVED_SOURCES_TABLE=YOUR_DB.YOUR_SCHEMA.TBL_DERIVED_SOURCES
SNOWFLAKE_AGENT_ORCHESTRATION_MODEL=claude-sonnet-4

# Usually left empty because deployed webapp uses same-origin /api routing.
CORS_ALLOWED_ORIGINS=

# Optional image tag override; otherwise the wrapper uses current git short SHA
IMAGE_TAG=
