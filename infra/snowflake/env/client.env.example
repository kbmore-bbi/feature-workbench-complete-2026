# -----------------------------------------------------------------------------
# Client SPCS deployment environment
# Copy this file to client.env and fill in the client-specific values.
# These values are consumed by the Snow CLI / browser-auth deployment scripts:
#   - scripts/bootstrap_client_spcs_tools.sh
#   - scripts/configure_client_snow_connection.sh
#   - scripts/deploy_spcs_client_snow.sh
#   - scripts/run_client_spcs_browser_deploy.sh
#   - scripts/deploy_spcs_client_snow_single_service.ps1
#   - scripts/run_client_spcs_browser_deploy_single_service.ps1
# -----------------------------------------------------------------------------

# Snow CLI connection settings
SNOWFLAKE_CONNECTION=client-spcs
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_USER=your_user
SNOWFLAKE_ROLE=your_deployer_role

# Warehouse / runtime namespace
SNOWFLAKE_WAREHOUSE=your_runtime_warehouse
# Workload warehouses. Leave blank to use the documented fallback chain, or
# set all four to the same X-Small warehouse for a single-warehouse deployment.
SNOWFLAKE_CONTROL_WAREHOUSE=your_control_xsmall_warehouse
SNOWFLAKE_AGENT_WAREHOUSE=your_agent_xsmall_warehouse
SNOWFLAKE_EXECUTION_WAREHOUSE=your_execution_medium_warehouse
SNOWFLAKE_PREPARATION_WAREHOUSE=your_control_xsmall_warehouse
AUTO_MAPPING_WAREHOUSE=your_agent_xsmall_warehouse
SNOWFLAKE_CONTROL_STATEMENT_TIMEOUT_SECONDS=60
SNOWFLAKE_AGENT_STATEMENT_TIMEOUT_SECONDS=300
SNOWFLAKE_EXECUTION_STATEMENT_TIMEOUT_SECONDS=900
SNOWFLAKE_PREPARATION_STATEMENT_TIMEOUT_SECONDS=300
SNOWFLAKE_AUTOMAP_STATEMENT_TIMEOUT_SECONDS=600
SNOWFLAKE_SESSION_HEALTHCHECK_INTERVAL_SECONDS=0
COCO_SIDECAR_ENABLED=false
APPLY_CALLER_GRANTS=false
INSTALL_CORTEX_CLI=0

# Independently reversible performance rollout flags.
PERF_DIAGNOSTICS_V1=true
PREPARED_CONTEXT_CACHE_V2=true
CONTEXT_SINGLEFLIGHT_V1=true
FIR_QUERY_PRUNING_V1=true
TARGET_SCOPED_CACHE_INVALIDATION_V1=true
RELATIONSHIP_CAPABILITY_CACHE_V1=true
RELATIONSHIP_PROC_FAST_GUARDS_V1=true
LOW_CONFIDENCE_JOIN_REVIEW_V1=false
AGENT_PAYLOAD_BUDGET_V1=true
AUTO_MAPPING_PAYLOAD_BUDGET_V1=true
AGENT_OVERSIZE_RETRY_V1=true
AGENT_OUTBOUND_MESSAGE_MAX_CHARS=60000
AGENT_OUTBOUND_MESSAGE_MAX_BYTES=65536
AGENT_THREAD_CONTEXT_MAX_CHARS=80000
BACKEND_READ_CACHE_V1=true
BACKEND_PROJECT_SUMMARY_CACHE_SECONDS=300
BACKEND_RECOMMENDATION_CACHE_SECONDS=15
STTM_SOURCE_BULK_WRITE_V1=true
CONVERSATION_MEMORY_V2=true
SNOWFLAKE_SESSION_LEASE_POOL_V1=false
LEARNING_PARALLEL_V1=false
PREPARE_PARALLEL_V1=false
AUTOSAVE_SINGLEFLIGHT_V1=true
AUTOSAVE_POSTSAVE_ASYNC_V1=false
PREPARATION_WAREHOUSE_ROUTING_V1=false
DURABLE_STTM_ROUTE_V1=true
AGENT_STREAM_BATCHING_V1=true
SNOWFLAKE_DATABASE=your_runtime_database
SNOWFLAKE_SCHEMA=your_runtime_schema

# Registry — format: <org>-<account>.registry.snowflakecomputing.com
SNOWFLAKE_REGISTRY_HOST=your_org-your_account.registry.snowflakecomputing.com
SNOWFLAKE_IMAGE_REPOSITORY=your_image_repository

# Compute pool and service name
SNOWFLAKE_COMPUTE_POOL=your_compute_pool
WEBAPP_SERVICE_NAME=your_webapp_service_name
SNOWFLAKE_NETWORK_POLICY=your_account_or_user_network_policy
WEB_COMPUTE_POOL_MIN_NODES=1
WEB_COMPUTE_POOL_MAX_NODES=1
WEB_COMPUTE_POOL_INSTANCE_FAMILY=CPU_X64_S
WEB_COMPUTE_POOL_AUTO_SUSPEND_SECONDS=3600
WEB_SERVICE_MIN_INSTANCES=1
WEB_SERVICE_MAX_INSTANCES=1

# Only needed for the split auto-mapping worker deployment path.
# Leave these populated only if you intend to deploy the separate worker service.
AUTO_MAPPING_COMPUTE_POOL=your_auto_mapping_compute_pool
AUTO_MAPPING_SERVICE_NAME=your_auto_mapping_service_name
AUTO_MAPPING_COMPUTE_POOL_MIN_NODES=1
AUTO_MAPPING_COMPUTE_POOL_MAX_NODES=2
AUTO_MAPPING_COMPUTE_POOL_INSTANCE_FAMILY=CPU_X64_S
AUTO_MAPPING_COMPUTE_POOL_AUTO_SUSPEND_SECONDS=300
AUTO_MAPPING_SERVICE_MIN_INSTANCES=2
AUTO_MAPPING_SERVICE_MAX_INSTANCES=2

# Egress integration already created by client admin
SNOWFLAKE_EGRESS_INTEGRATION=your_egress_integration

# App runtime
APP_NAME=BBI AI Migration Workbench API
APP_ENV=client
AUTH_MODE=custom_oauth
SPCS_EXECUTE_AS_CALLER_ENABLED=true
SPCS_ENABLE_CUSTOM_CREDENTIALS=true
USERS_TABLE=YOUR_DB.YOUR_SCHEMA.TBL_USERS
SNOWFLAKE_OAUTH_SESSIONS_TABLE=YOUR_DB.YOUR_SCHEMA.TBL_WORKBENCH_OAUTH_SESSIONS

# Snowflake custom OAuth
# Password-type Snowflake secret whose username is the OAuth client ID and
# password is the OAuth client secret. The deployer/service owner needs READ.
SNOWFLAKE_OAUTH_CLIENT_SECRET_OBJECT=YOUR_DB.YOUR_SCHEMA.STTM_BUILDER_OAUTH_CLIENT_CREDENTIALS
SNOWFLAKE_OAUTH_SESSION_SECRET_OBJECT=YOUR_DB.YOUR_SCHEMA.STTM_BUILDER_OAUTH_SESSION_KEYS
SNOWFLAKE_OAUTH_AUTHORIZE_URL=https://your_org-your_account.snowflakecomputing.com/oauth/authorize
SNOWFLAKE_OAUTH_TOKEN_URL=https://your_org-your_account.snowflakecomputing.com/oauth/token-request
SNOWFLAKE_OAUTH_REDIRECT_URI=https://your-public-app-url/api/v1/auth/callback
SNOWFLAKE_OAUTH_SCOPE=session:role-any
AUTH_SESSION_COOKIE_NAME=sttm_session
AUTH_STATE_COOKIE_NAME=sttm_oauth_state
AUTH_SESSION_COOKIE_SECURE=true
AUTH_SESSION_COOKIE_SAMESITE=lax
AUTH_POST_LOGIN_REDIRECT_PATH=/dashboard
AUTH_POST_LOGOUT_REDIRECT_PATH=/home

# Persona role mapping
APP_ROLE_ADMIN=CLIENT_ADMIN_ROLE
APP_ROLE_PUBLISHER=CLIENT_PUBLISHER_ROLE
APP_ROLE_VIEWER=CLIENT_VIEWER_ROLE

# Cortex Agent configuration
SNOWFLAKE_STTM_BUILDER_AGENT=YOUR_DB.YOUR_SCHEMA.AGT_STTM_BUILDER
SNOWFLAKE_SOURCE_MAPPING_AGENT=YOUR_DB.YOUR_SCHEMA.AGT_SOURCE_MAPPING
SNOWFLAKE_SEMANTIC_MODEL_AGENT=FOCUS_DB_2.STTM_MCP.AGT_SEMANTIC_MODEL_V2
SNOWFLAKE_DBT_CONVERSION_AGENT=YOUR_DB.YOUR_SCHEMA.AGT_DBT_CONVERSION
SNOWFLAKE_TEST_CASE_GENERATION_AGENT=YOUR_DB.YOUR_SCHEMA.AGT_DBT_TEST_GENERATION
# Compatibility-only: normal assistant requests now use AGT_STTM_BUILDER.
# Leave blank to default to SNOWFLAKE_STTM_BUILDER_AGENT.
SNOWFLAKE_WORKBENCH_CONVERSATION_AGENT=
SNOWFLAKE_RELATIONSHIPS_PROCEDURE=YOUR_DB.YOUR_SCHEMA.SP_GET_TABLE_RELATIONSHIPS
SNOWFLAKE_SEMANTIC_MODEL_TABLE=YOUR_DB.YOUR_SCHEMA.TBL_SEMANTIC_MODELS
# Semantic-model source registry. Bundle composition merges all three latest views.
SNOWFLAKE_SEMANTIC_VIEWS_DATABASE=FOCUS_DB_2
SNOWFLAKE_SEMANTIC_VIEWS_SCHEMA=STTM_MCP
SNOWFLAKE_SEMANTIC_TABLE_VIEWS_TABLE=LATEST_TABLE_VIEWS
SNOWFLAKE_SEMANTIC_COLUMN_VIEWS_TABLE=LATEST_COLUMN_VIEWS
SNOWFLAKE_SEMANTIC_NATIVE_VIEWS_TABLE=LATEST_NATIVE_VIEWS
SNOWFLAKE_DERIVED_SOURCES_TABLE=YOUR_DB.YOUR_SCHEMA.TBL_DERIVED_SOURCES
SNOWFLAKE_AGENT_ORCHESTRATION_MODEL=claude-sonnet-4

# Durable conversation rollover and content-addressed agent artifacts
SNOWFLAKE_CONVERSATION_SEGMENTS_TABLE=YOUR_DB.YOUR_SCHEMA.TBL_WORKBENCH_CONVERSATION_SEGMENTS
SNOWFLAKE_PROJECT_ATTRIBUTES_TABLE=TBL_PROJECT_ATTRIBUTES
SNOWFLAKE_AGENT_ARTIFACT_STAGE=YOUR_DB.YOUR_SCHEMA.AI_WORKBENCH_ARTIFACTS
AGENT_INLINE_ARTIFACT_LIMIT_BYTES=32768
AGENT_CALLER_INLINE_FALLBACK_LIMIT_BYTES=1048576
AGENT_ARTIFACT_DRAFT_RETENTION_DAYS=90
AGENT_CONTEXT_LIMIT_TOKENS=90000
AGENT_THREAD_ROLLOVER_RATIO=0.65
AGENT_THREAD_HARD_RATIO=0.80
AGENT_RECENT_TURNS_TO_KEEP=8
AGENT_MAX_TURNS_PER_SEGMENT=60

# Optional DBT repo bootstrap for AGT_DBT_CONVERSION.
# Leave blank to skip DBT repo bootstrap. When provided, the wrapper and helper
# scripts will create the Snowflake Git repository objects and fetch the repo.
SNOWFLAKE_DBT_GIT_API_INTEGRATION=GIT_API_INTEGRATION_DBT
SNOWFLAKE_DBT_GIT_ALLOWED_PREFIX=https://github.com/your-org-or-user/
SNOWFLAKE_DBT_GIT_SECRET_NAME=GIT_SECRET_DBT
SNOWFLAKE_DBT_GIT_USERNAME=
SNOWFLAKE_DBT_GIT_PAT=
SNOWFLAKE_DBT_GIT_REPOSITORY_NAME=DBT_REPO
SNOWFLAKE_DBT_GIT_ORIGIN=
SNOWFLAKE_DBT_GIT_CONSUMER_ROLE=

# Usually left empty because deployed webapp uses same-origin /api routing.
CORS_ALLOWED_ORIGINS=

# Private auto-mapping worker
# The deploy script can derive the internal DNS host automatically using:
#   http://<endpoint>.<service>.<SYSTEM$GET_SERVICE_DNS_DOMAIN()>:8000
# Leave AUTO_MAPPING_SERVICE_URL empty unless you want to override it manually.
# Use `inprocess` only for local/integration testing when a second socket is undesirable.
AUTO_MAPPING_SERVICE_URL=
AUTO_MAPPING_ENDPOINT_NAME=api
AUTO_MAPPING_SERVICE_TIMEOUT_SECONDS=300
AUTO_MAPPING_SERVICE_RETRY_ATTEMPTS=2
AUTO_MAPPING_WORKER_MAX_CONCURRENCY=5
AUTO_MAPPING_PROXY_BATCH_SIZE=17
AUTO_MAPPING_PROXY_MAX_IN_FLIGHT=2
AUTO_MAP_PIPELINE_V2=false
# Derived automatically by the deployment script from the extracted YAML files.
# AGENT_SPEC_SOURCE_MAPPING_SHA256=
# AGENT_SPEC_TRANSFORMATION_RULE_SHA256=

# Reliability tuning for caller-rights sessions and Cortex Agent calls
SNOWFLAKE_SESSION_RETRY_ATTEMPTS=2
SNOWFLAKE_SESSION_RETRY_BACKOFF_SECONDS=1.0
SNOWFLAKE_USER_SESSION_CACHE_TTL_SECONDS=1800
SNOWFLAKE_AGENT_RETRY_ATTEMPTS=3
SNOWFLAKE_AGENT_RETRY_BACKOFF_SECONDS=1.0

# Optional image tag override; otherwise the wrapper uses current git short SHA
IMAGE_TAG=
# FIR runtime retrieval and unified notification delivery
FIR_LEARNING_CONTEXT_ENABLED=true
FIR_SIGNAL_BUS_ENABLED=true

# Prepared workspace context, genuine Agent/Analyst streaming, and durable
# target-column FIR learning. Cache validity is dependency/version based.
PREPARED_WORKSPACE_CONTEXT_V2=true
ASSISTANT_STREAMING_V2=true
FIR_TARGET_MAPPING_PATTERNS_V2=true
FIR_DOCUMENT_LINEAGE_V3=true
FIR_DURABLE_JOBS_V2=true
PREPARED_CONTEXT_L1_IDLE_SECONDS=3600
PREPARED_CONTEXT_SOFT_REVALIDATE_SECONDS=86400
PREPARED_CONTEXT_CLEANUP_DAYS=30
PREPARED_CONTEXT_DEBOUNCE_MS=750
SNOWFLAKE_PREPARED_WORKSPACE_CONTEXTS_TABLE=TBL_PREPARED_WORKSPACE_CONTEXTS
SNOWFLAKE_TARGET_MAPPING_PATTERNS_TABLE=TBL_FIR_TARGET_MAPPING_PATTERNS
SNOWFLAKE_FIR_LEARNING_JOBS_TABLE=TBL_FIR_LEARNING_JOBS
SNOWFLAKE_FIR_LEARNING_WORK_ITEMS_TABLE=TBL_FIR_LEARNING_WORK_ITEMS
FIR_PIPELINE_ENABLED=true
FIR_AGENT_PROCESSING_ENABLED=true
FIR_CATCHUP_SCHEDULE_CRON=USING CRON 0 2,14 * * * UTC
FIR_AGENT_REQUEST_TIMEOUT_SECONDS=840
FIR_AGENT_MAX_ASSETS_PER_RUN=1
FIR_AGENT_MAX_PATTERNS_PER_BATCH=10
FIR_AGENT_MAX_CONCURRENCY=2
FIR_AGENT_RETRY_LIMIT=2
FIR_PROCESS_UPLOADS_IMMEDIATELY=true
FIR_UPLOAD_EXPLANATIONS_ENABLED=true
FIR_UPLOAD_EXPLANATION_MODEL=claude-haiku-4-5
FIR_AGENT_DAILY_REQUEST_LIMIT=50
FIR_AGENT_DAILY_TOKEN_LIMIT=20000000
FIR_JOB_MAX_RUNTIME_SECONDS=3600
SNOWFLAKE_PROJECT_ATTRIBUTES_TABLE=TBL_PROJECT_ATTRIBUTES
