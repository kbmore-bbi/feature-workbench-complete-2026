# -----------------------------------------------------------------------------
# Client-facing SPCS Streamlit demo environment
# Copy this file to client.streamlit-demo.env and fill in client-specific values.
# -----------------------------------------------------------------------------

SNOWFLAKE_CONNECTION=client-spcs-demo
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_HOST=your_org-your_account.snowflakecomputing.com
SNOWFLAKE_USER=your_user
SNOWFLAKE_ROLE=your_deployer_role
SNOWFLAKE_WAREHOUSE=your_runtime_warehouse
SNOWFLAKE_DATABASE=your_runtime_database
SNOWFLAKE_SCHEMA=your_runtime_schema

# Registry
SNOWFLAKE_REGISTRY_HOST=your_org-your_account.registry.snowflakecomputing.com
SNOWFLAKE_IMAGE_REPOSITORY=your_image_repository

# Stage + compute pool + service
SNOWFLAKE_DEPLOY_STAGE=YOUR_DB.YOUR_SCHEMA.YOUR_DEPLOY_STAGE
SNOWFLAKE_COMPUTE_POOL=your_compute_pool
STREAMLIT_DEMO_SERVICE_NAME=your_streamlit_demo_service

# Optional image tag override
IMAGE_TAG=demo-001

# UI
DEMO_TITLE=Snowflake Access Browser Demo
