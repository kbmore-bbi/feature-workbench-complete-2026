# Snowflake identity
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_HOST=your_org-your_account.snowflakecomputing.com

# App runtime
APP_NAME=BBI AI Migration Workbench API
APP_ENV=dev
AUTO_MAP_PIPELINE_V2=true
AUTH_MODE=custom_oauth
SPCS_ENABLE_CUSTOM_CREDENTIALS=true
USERS_TABLE=TBL_USERS
SNOWFLAKE_OAUTH_SESSIONS_TABLE=TBL_WORKBENCH_OAUTH_SESSIONS
APP_ROLE_ADMIN=WORKBENCH_ADMIN
APP_ROLE_PUBLISHER=WORKBENCH_PUBLISHER
APP_ROLE_VIEWER=WORKBENCH_VIEWER
SNOWFLAKE_OAUTH_CLIENT_ID=
SNOWFLAKE_OAUTH_CLIENT_SECRET=
SNOWFLAKE_OAUTH_CLIENT_SECRET_OBJECT=FFP_HDP_CRM_MIG_DB_DEV.SCH_STTM_METADATA.STTM_BUILDER_OAUTH_CLIENT_CREDENTIALS
SNOWFLAKE_OAUTH_SESSION_SECRET_OBJECT=FFP_HDP_CRM_MIG_DB_DEV.SCH_STTM_METADATA.STTM_BUILDER_OAUTH_SESSION_KEYS
SNOWFLAKE_OAUTH_AUTHORIZE_URL=https://your_org-your_account.snowflakecomputing.com/oauth/authorize
SNOWFLAKE_OAUTH_TOKEN_URL=https://your_org-your_account.snowflakecomputing.com/oauth/token-request
SNOWFLAKE_OAUTH_REDIRECT_URI=https://your-webapp-url/api/v1/auth/callback
SNOWFLAKE_OAUTH_SCOPE=session:role-any
AUTH_SESSION_SECRET=
AUTH_SESSION_ENCRYPTION_KEY=
AUTH_POST_LOGIN_REDIRECT_PATH=/dashboard
AUTH_POST_LOGOUT_REDIRECT_PATH=/home

# Registry — format: <org>-<account>.registry.snowflakecomputing.com
# NOTE: account name uses hyphens here even if your Snowflake account identifier uses underscores.
# Confirm the exact URL with: SHOW IMAGE REPOSITORIES IN SCHEMA <db>.<schema>;
SNOWFLAKE_REGISTRY_HOST=your_org-your_account.registry.snowflakecomputing.com

# Target database / schema / repo
SNOWFLAKE_DATABASE=FFP_HDP_CRM_MIG_DB_DEV
SNOWFLAKE_SCHEMA=SCH_STTM_METADATA
SNOWFLAKE_IMAGE_REPOSITORY=AI_WORKBENCH_DEV_IMAGES

# Role
SNOWFLAKE_ROLE=your_role

# Compute pool
SNOWFLAKE_COMPUTE_POOL=AI_WORKBENCH_DEV_POOL
SNOWFLAKE_NETWORK_POLICY=your_account_or_user_network_policy

# Service names (used as Snowflake SPCS service identifiers)
STTM_BUILDER_SERVICE_NAME=STTM_BUILDER_DEV
WEBAPP_SERVICE_NAME=WORKBENCH_WEBAPP_DEV

# Image tag (default: latest)
IMAGE_TAG=latest

# External Access Integration — created once by setup-egress.sql (ACCOUNTADMIN required).
# Grants sttm-builder egress to SNOWFLAKE_HOST:443 for Snowpark SQL and Cortex Agents REST API.
SNOWFLAKE_EGRESS_INTEGRATION=AI_WORKBENCH_EGRESS_INTEGRATION

# sttm-builder runtime
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_CONTROL_WAREHOUSE=your_control_xsmall_warehouse
SNOWFLAKE_AGENT_WAREHOUSE=your_agent_xsmall_warehouse
SNOWFLAKE_EXECUTION_WAREHOUSE=your_execution_medium_warehouse
AUTO_MAPPING_WAREHOUSE=your_agent_xsmall_warehouse
SNOWFLAKE_CONTROL_STATEMENT_TIMEOUT_SECONDS=60
SNOWFLAKE_AGENT_STATEMENT_TIMEOUT_SECONDS=300
SNOWFLAKE_EXECUTION_STATEMENT_TIMEOUT_SECONDS=900
SNOWFLAKE_AUTOMAP_STATEMENT_TIMEOUT_SECONDS=600
SNOWFLAKE_SESSION_HEALTHCHECK_INTERVAL_SECONDS=0
SNOWFLAKE_STTM_BUILDER_AGENT=FFP_HDP_CRM_MIG_DB_DEV.SCH_STTM_METADATA.AGT_STTM_BUILDER
SNOWFLAKE_WORKBENCH_CONVERSATION_AGENT=FFP_HDP_CRM_MIG_DB_DEV.SCH_STTM_METADATA.AGT_WORKBENCH_CONVERSATION
SNOWFLAKE_SEMANTIC_MODEL_AGENT=FOCUS_DB_2.STTM_MCP.AGT_SEMANTIC_MODEL_V2
SNOWFLAKE_TEST_CASE_GENERATION_AGENT=FFP_HDP_CRM_MIG_DB_DEV.SCH_STTM_METADATA.AGT_DBT_TEST_GENERATION
SNOWFLAKE_RELATIONSHIPS_PROCEDURE=FFP_HDP_CRM_MIG_DB_DEV.SCH_STTM_METADATA.SP_GET_TABLE_RELATIONSHIPS
SNOWFLAKE_SEMANTIC_MODEL_TABLE=FFP_HDP_CRM_MIG_DB_DEV.SCH_STTM_METADATA.TBL_SEMANTIC_MODELS
SNOWFLAKE_SEMANTIC_VIEWS_DATABASE=FOCUS_DB_2
SNOWFLAKE_SEMANTIC_VIEWS_SCHEMA=STTM_MCP
SNOWFLAKE_SEMANTIC_TABLE_VIEWS_TABLE=LATEST_TABLE_VIEWS
SNOWFLAKE_SEMANTIC_COLUMN_VIEWS_TABLE=LATEST_COLUMN_VIEWS
SNOWFLAKE_SEMANTIC_NATIVE_VIEWS_TABLE=LATEST_NATIVE_VIEWS
SNOWFLAKE_DERIVED_SOURCES_TABLE=FFP_HDP_CRM_MIG_DB_DEV.SCH_STTM_METADATA.TBL_DERIVED_SOURCES
SNOWFLAKE_CONVERSATION_SEGMENTS_TABLE=FFP_HDP_CRM_MIG_DB_DEV.SCH_STTM_METADATA.TBL_WORKBENCH_CONVERSATION_SEGMENTS
SNOWFLAKE_PROJECT_ATTRIBUTES_TABLE=TBL_PROJECT_ATTRIBUTES
SNOWFLAKE_AGENT_ARTIFACT_STAGE=FFP_HDP_CRM_MIG_DB_DEV.SCH_STTM_METADATA.AI_WORKBENCH_ARTIFACTS
AGENT_INLINE_ARTIFACT_LIMIT_BYTES=32768
AGENT_ARTIFACT_DRAFT_RETENTION_DAYS=90
AGENT_CONTEXT_LIMIT_TOKENS=90000
AGENT_THREAD_ROLLOVER_RATIO=0.65
AGENT_THREAD_HARD_RATIO=0.80
AGENT_RECENT_TURNS_TO_KEEP=8
AGENT_MAX_TURNS_PER_SEGMENT=60
SNOWFLAKE_CONVERSATION_TURNS_TABLE=FFP_HDP_CRM_MIG_DB_DEV.SCH_STTM_METADATA.TBL_WORKBENCH_CONVERSATION_TURNS
SNOWFLAKE_CONVERSATION_FEEDBACK_TABLE=FFP_HDP_CRM_MIG_DB_DEV.SCH_STTM_METADATA.TBL_WORKBENCH_FEEDBACK
SNOWFLAKE_CONVERSATION_RECOMMENDATIONS_TABLE=FFP_HDP_CRM_MIG_DB_DEV.SCH_STTM_METADATA.TBL_WORKBENCH_RECOMMENDATIONS
SNOWFLAKE_RELATIONSHIP_FACTS_TABLE=FFP_HDP_CRM_MIG_DB_DEV.SCH_STTM_METADATA.TBL_WORKBENCH_RELATIONSHIP_FACTS
SNOWFLAKE_RAG_DOCUMENTS_TABLE=FFP_HDP_CRM_MIG_DB_DEV.SCH_STTM_METADATA.TBL_WORKBENCH_RAG_DOCUMENTS
SNOWFLAKE_RAG_SEARCH_SERVICE=FFP_HDP_CRM_MIG_DB_DEV.SCH_STTM_METADATA.CSS_WORKBENCH_RAG
SNOWFLAKE_AGENT_ORCHESTRATION_MODEL=claude-sonnet-4

# CORS is only needed for direct local/dev access; the deployed webapp uses same-origin /api calls.
CORS_ALLOWED_ORIGINS=
# FIR runtime retrieval and unified notification delivery
FIR_LEARNING_CONTEXT_ENABLED=true
FIR_SIGNAL_BUS_ENABLED=true
PREPARED_WORKSPACE_CONTEXT_V2=true
ASSISTANT_STREAMING_V2=true
FIR_TARGET_MAPPING_PATTERNS_V2=true
FIR_DOCUMENT_LINEAGE_V3=true
FIR_DURABLE_JOBS_V2=true
PREPARED_CONTEXT_L1_IDLE_SECONDS=3600
PREPARED_CONTEXT_SOFT_REVALIDATE_SECONDS=86400
PREPARED_CONTEXT_CLEANUP_DAYS=30
PREPARED_CONTEXT_DEBOUNCE_MS=750
SNOWFLAKE_PREPARED_WORKSPACE_CONTEXTS_TABLE=TBL_PREPARED_WORKSPACE_CONTEXTS
SNOWFLAKE_TARGET_MAPPING_PATTERNS_TABLE=TBL_FIR_TARGET_MAPPING_PATTERNS
SNOWFLAKE_FIR_LEARNING_JOBS_TABLE=TBL_FIR_LEARNING_JOBS
SNOWFLAKE_FIR_LEARNING_WORK_ITEMS_TABLE=TBL_FIR_LEARNING_WORK_ITEMS
FIR_PIPELINE_ENABLED=true
FIR_AGENT_PROCESSING_ENABLED=true
FIR_CATCHUP_SCHEDULE_CRON=USING CRON 0 2,14 * * * UTC
FIR_AGENT_REQUEST_TIMEOUT_SECONDS=840
FIR_AGENT_MAX_ASSETS_PER_RUN=1
FIR_AGENT_MAX_PATTERNS_PER_BATCH=10
FIR_AGENT_MAX_CONCURRENCY=2
FIR_AGENT_RETRY_LIMIT=2
FIR_PROCESS_UPLOADS_IMMEDIATELY=true
FIR_UPLOAD_EXPLANATIONS_ENABLED=true
FIR_UPLOAD_EXPLANATION_MODEL=claude-haiku-4-5
FIR_AGENT_DAILY_REQUEST_LIMIT=50
FIR_AGENT_DAILY_TOKEN_LIMIT=20000000
FIR_JOB_MAX_RUNTIME_SECONDS=3600
SNOWFLAKE_PROJECT_ATTRIBUTES_TABLE=TBL_PROJECT_ATTRIBUTES
