# Snowflake identity
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_HOST=your_org-your_account.snowflakecomputing.com

# Registry — format: <org>-<account>.registry.snowflakecomputing.com
# NOTE: account name uses hyphens here even if your Snowflake account identifier uses underscores.
# Confirm the exact URL with: SHOW IMAGE REPOSITORIES IN SCHEMA <db>.<schema>;
SNOWFLAKE_REGISTRY_HOST=your_org-your_account.registry.snowflakecomputing.com

# Target database / schema / repo
SNOWFLAKE_DATABASE=FFP_HDP_CRM_MIG_DB_DEV
SNOWFLAKE_SCHEMA=SCH_STTM_METADATA
SNOWFLAKE_IMAGE_REPOSITORY=AI_WORKBENCH_DEV_IMAGES

# Role
SNOWFLAKE_ROLE=your_role

# Compute pool
SNOWFLAKE_COMPUTE_POOL=AI_WORKBENCH_DEV_POOL

# Service names
STTM_BUILDER_SERVICE_NAME=STTM_BUILDER_DEV
API_GATEWAY_SERVICE_NAME=API_GATEWAY_DEV

# Image tag (default: latest)
IMAGE_TAG=latest

# sttm-builder runtime
SNOWFLAKE_AUTO_MAP_AGENT=FFP_HDP_CRM_MIG_DB_DEV.SCH_STTM_METADATA.AUTO_MAP_AGENT
SNOWFLAKE_AGENT_ORCHESTRATION_MODEL=claude-sonnet-4
