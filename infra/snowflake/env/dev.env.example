# Snowflake identity
SNOWFLAKE_ACCOUNT=your_org-your_account
SNOWFLAKE_HOST=your_org-your_account.snowflakecomputing.com

# Registry — format: <org>-<account>.registry.snowflakecomputing.com
# NOTE: account name uses hyphens here even if your Snowflake account identifier uses underscores.
# Confirm the exact URL with: SHOW IMAGE REPOSITORIES IN SCHEMA <db>.<schema>;
SNOWFLAKE_REGISTRY_HOST=your_org-your_account.registry.snowflakecomputing.com

# Target database / schema / repo
SNOWFLAKE_DATABASE=FFP_HDP_CRM_MIG_DB_DEV
SNOWFLAKE_SCHEMA=SCH_STTM_METADATA
SNOWFLAKE_IMAGE_REPOSITORY=AI_WORKBENCH_DEV_IMAGES

# Role
SNOWFLAKE_ROLE=your_role

# Compute pool
SNOWFLAKE_COMPUTE_POOL=AI_WORKBENCH_DEV_POOL

# Service names (used as Snowflake SPCS service identifiers)
STTM_BUILDER_SERVICE_NAME=STTM_BUILDER_DEV
FRONTEND_SERVICE_NAME=FRONTEND_DEV

# Image tag (default: latest)
IMAGE_TAG=latest

# External Access Integration — created once by setup-egress.sql (ACCOUNTADMIN required).
# Grants sttm-builder egress to SNOWFLAKE_HOST:443 for Snowpark SQL and Cortex Agents REST API.
SNOWFLAKE_EGRESS_INTEGRATION=AI_WORKBENCH_EGRESS_INTEGRATION

# sttm-builder runtime
SNOWFLAKE_STTM_BUILDER_AGENT=FFP_HDP_CRM_MIG_DB_DEV.SCH_STTM_METADATA.STTM_BUILDER_AGENT
SNOWFLAKE_AGENT_ORCHESTRATION_MODEL=claude-sonnet-4

# CORS — set to the frontend service's public ingress URL after FRONTEND_DEV is deployed.
# Run: SHOW ENDPOINTS IN SERVICE <db>.<schema>.FRONTEND_DEV; to get the ingress URL.
# Use "*" to allow all origins (dev only).
CORS_ALLOWED_ORIGINS=*

# Frontend runtime — set to STTM_BUILDER_DEV's public ingress URL after it is deployed.
# Run: SHOW ENDPOINTS IN SERVICE <db>.<schema>.STTM_BUILDER_DEV; to get the ingress URL.
STTM_BUILDER_URL=https://<sttm-builder-ingress-url>.snowflakecomputing.app
