-- Workbench warehouse guardrails.
--
-- Replace the placeholders from client.env/deployment automation before running.
-- Resource monitors protect warehouse credits only. Cortex and SPCS consumption
-- are monitored separately by workbench_cost_dashboard.sql.

CREATE RESOURCE MONITOR IF NOT EXISTS <CONTROL_RESOURCE_MONITOR>
  WITH CREDIT_QUOTA = <CONTROL_MONTHLY_CREDIT_QUOTA>
  FREQUENCY = MONTHLY
  START_TIMESTAMP = IMMEDIATELY
  TRIGGERS
    ON 70 PERCENT DO NOTIFY
    ON 90 PERCENT DO NOTIFY
    ON 100 PERCENT DO SUSPEND
    ON 110 PERCENT DO SUSPEND_IMMEDIATE;

CREATE RESOURCE MONITOR IF NOT EXISTS <AGENT_RESOURCE_MONITOR>
  WITH CREDIT_QUOTA = <AGENT_MONTHLY_CREDIT_QUOTA>
  FREQUENCY = MONTHLY
  START_TIMESTAMP = IMMEDIATELY
  TRIGGERS
    ON 70 PERCENT DO NOTIFY
    ON 90 PERCENT DO NOTIFY
    ON 100 PERCENT DO SUSPEND
    ON 110 PERCENT DO SUSPEND_IMMEDIATE;

CREATE RESOURCE MONITOR IF NOT EXISTS <EXECUTION_RESOURCE_MONITOR>
  WITH CREDIT_QUOTA = <EXECUTION_MONTHLY_CREDIT_QUOTA>
  FREQUENCY = MONTHLY
  START_TIMESTAMP = IMMEDIATELY
  TRIGGERS
    ON 70 PERCENT DO NOTIFY
    ON 90 PERCENT DO NOTIFY
    ON 100 PERCENT DO SUSPEND
    ON 110 PERCENT DO SUSPEND_IMMEDIATE;

ALTER WAREHOUSE <CONTROL_WAREHOUSE> SET
  AUTO_RESUME = TRUE
  AUTO_SUSPEND = 60
  RESOURCE_MONITOR = <CONTROL_RESOURCE_MONITOR>;

ALTER WAREHOUSE <AGENT_WAREHOUSE> SET
  AUTO_RESUME = TRUE
  AUTO_SUSPEND = 60
  RESOURCE_MONITOR = <AGENT_RESOURCE_MONITOR>;

ALTER WAREHOUSE <EXECUTION_WAREHOUSE> SET
  AUTO_RESUME = TRUE
  AUTO_SUSPEND = 60
  RESOURCE_MONITOR = <EXECUTION_RESOURCE_MONITOR>;

