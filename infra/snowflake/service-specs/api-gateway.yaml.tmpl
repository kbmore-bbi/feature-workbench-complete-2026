spec:
  containers:
    - name: api-gateway
      image: /${SNOWFLAKE_DATABASE_LOWER}/${SNOWFLAKE_SCHEMA_LOWER}/${SNOWFLAKE_IMAGE_REPOSITORY_LOWER}/api-gateway:${IMAGE_TAG}
      env:
        STTM_BUILDER_UPSTREAM: "${STTM_BUILDER_SERVICE_HOST}:8000"
        FRONTEND_UPSTREAM: "127.0.0.1:3000"
      resources:
        requests:
          cpu: "0.25"
          memory: "512Mi"
        limits:
          cpu: "0.5"
          memory: "1Gi"
      readinessProbe:
        port: 9000
        path: /healthz

    - name: frontend
      image: /${SNOWFLAKE_DATABASE_LOWER}/${SNOWFLAKE_SCHEMA_LOWER}/${SNOWFLAKE_IMAGE_REPOSITORY_LOWER}/frontend:${IMAGE_TAG}
      env:
        NODE_ENV: "production"
        PORT: "3000"
        HOSTNAME: "0.0.0.0"
      resources:
        requests:
          cpu: "0.5"
          memory: "1Gi"
        limits:
          cpu: "1"
          memory: "2Gi"
      readinessProbe:
        port: 3000

  endpoints:
    - name: gateway
      port: 9000
      public: true
