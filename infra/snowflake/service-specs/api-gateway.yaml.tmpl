spec:
  containers:
    - name: api-gateway
      image: /${SNOWFLAKE_DATABASE_LOWER}/${SNOWFLAKE_SCHEMA_LOWER}/${SNOWFLAKE_IMAGE_REPOSITORY_LOWER}/api-gateway:${IMAGE_TAG}
      env:
        STTM_BUILDER_UPSTREAM: "sttm-builder-dev.p4ed.svc.spcs.internal:8000"
      resources:
        requests:
          cpu: "0.25"
          memory: "512Mi"
        limits:
          cpu: "0.5"
          memory: "1Gi"
      readinessProbe:
        port: 9000
        path: /healthz

  endpoints:
    - name: gateway
      port: 9000
      public: true
