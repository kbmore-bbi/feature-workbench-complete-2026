spec:
  containers:
    - name: automap-worker
      image: /${SNOWFLAKE_DATABASE_LOWER}/${SNOWFLAKE_SCHEMA_LOWER}/${SNOWFLAKE_IMAGE_REPOSITORY_LOWER}/sttm-automap-worker:${IMAGE_TAG}
      env:
        APP_NAME: ${APP_NAME}
        APP_ENV: ${APP_ENV}
        APP_VERSION: ${IMAGE_TAG}
        APP_MODULE: app.auto_mapping_worker.main:app
        PORT: "8000"
        AUTH_MODE: ${AUTH_MODE}
        SPCS_EXECUTE_AS_CALLER_ENABLED: "${SPCS_EXECUTE_AS_CALLER_ENABLED}"
        LOCAL_DEV_AUTH_ENABLED: "false"
        LOCAL_DEV_BYPASS_METADATA: "false"
        USERS_TABLE: ${USERS_TABLE}
        APP_ROLE_ADMIN: ${APP_ROLE_ADMIN}
        APP_ROLE_PUBLISHER: ${APP_ROLE_PUBLISHER}
        APP_ROLE_VIEWER: ${APP_ROLE_VIEWER}
        # Let Snowflake inject the runtime account/host inside SPCS.
        # Overriding these with deploy-time values can invalidate caller-rights OAuth.
        SNOWFLAKE_WAREHOUSE: ${SNOWFLAKE_WAREHOUSE}
        SNOWFLAKE_CONTROL_WAREHOUSE: ${SNOWFLAKE_CONTROL_WAREHOUSE}
        SNOWFLAKE_AGENT_WAREHOUSE: ${SNOWFLAKE_AGENT_WAREHOUSE}
        SNOWFLAKE_EXECUTION_WAREHOUSE: ${SNOWFLAKE_EXECUTION_WAREHOUSE}
        AUTO_MAPPING_WAREHOUSE: ${AUTO_MAPPING_WAREHOUSE}
        SNOWFLAKE_CONTROL_STATEMENT_TIMEOUT_SECONDS: "${SNOWFLAKE_CONTROL_STATEMENT_TIMEOUT_SECONDS}"
        SNOWFLAKE_AGENT_STATEMENT_TIMEOUT_SECONDS: "${SNOWFLAKE_AGENT_STATEMENT_TIMEOUT_SECONDS}"
        SNOWFLAKE_EXECUTION_STATEMENT_TIMEOUT_SECONDS: "${SNOWFLAKE_EXECUTION_STATEMENT_TIMEOUT_SECONDS}"
        SNOWFLAKE_AUTOMAP_STATEMENT_TIMEOUT_SECONDS: "${SNOWFLAKE_AUTOMAP_STATEMENT_TIMEOUT_SECONDS}"
        SNOWFLAKE_SESSION_HEALTHCHECK_INTERVAL_SECONDS: "${SNOWFLAKE_SESSION_HEALTHCHECK_INTERVAL_SECONDS}"
        SNOWFLAKE_REST_HOST: ${SNOWFLAKE_REST_HOST}
        SNOWFLAKE_DATABASE: ${SNOWFLAKE_DATABASE}
        SNOWFLAKE_SCHEMA: ${SNOWFLAKE_SCHEMA}
        SNOWFLAKE_STTM_BUILDER_AGENT: ${SNOWFLAKE_STTM_BUILDER_AGENT}
        SNOWFLAKE_SOURCE_MAPPING_AGENT: ${SNOWFLAKE_SOURCE_MAPPING_AGENT}
        SNOWFLAKE_WORKBENCH_CONVERSATION_AGENT: ${SNOWFLAKE_WORKBENCH_CONVERSATION_AGENT}
        SNOWFLAKE_SEMANTIC_MODEL_AGENT: ${SNOWFLAKE_SEMANTIC_MODEL_AGENT}
        SNOWFLAKE_DBT_CONVERSION_AGENT: ${SNOWFLAKE_DBT_CONVERSION_AGENT}
        SNOWFLAKE_TEST_CASE_GENERATION_AGENT: ${SNOWFLAKE_TEST_CASE_GENERATION_AGENT}
        SNOWFLAKE_RELATIONSHIPS_PROCEDURE: ${SNOWFLAKE_RELATIONSHIPS_PROCEDURE}
        SNOWFLAKE_SEMANTIC_MODEL_TABLE: ${SNOWFLAKE_SEMANTIC_MODEL_TABLE}
        SNOWFLAKE_SEMANTIC_VIEWS_DATABASE: "${SNOWFLAKE_SEMANTIC_VIEWS_DATABASE}"
        SNOWFLAKE_SEMANTIC_VIEWS_SCHEMA: "${SNOWFLAKE_SEMANTIC_VIEWS_SCHEMA}"
        SNOWFLAKE_SEMANTIC_TABLE_VIEWS_TABLE: ${SNOWFLAKE_SEMANTIC_TABLE_VIEWS_TABLE}
        SNOWFLAKE_SEMANTIC_COLUMN_VIEWS_TABLE: ${SNOWFLAKE_SEMANTIC_COLUMN_VIEWS_TABLE}
        SNOWFLAKE_SEMANTIC_NATIVE_VIEWS_TABLE: ${SNOWFLAKE_SEMANTIC_NATIVE_VIEWS_TABLE}
        SNOWFLAKE_DERIVED_SOURCES_TABLE: ${SNOWFLAKE_DERIVED_SOURCES_TABLE}
        SNOWFLAKE_CONVERSATION_TURNS_TABLE: ${SNOWFLAKE_CONVERSATION_TURNS_TABLE}
        SNOWFLAKE_CONVERSATION_FEEDBACK_TABLE: ${SNOWFLAKE_CONVERSATION_FEEDBACK_TABLE}
        SNOWFLAKE_CONVERSATION_RECOMMENDATIONS_TABLE: ${SNOWFLAKE_CONVERSATION_RECOMMENDATIONS_TABLE}
        SNOWFLAKE_RELATIONSHIP_FACTS_TABLE: ${SNOWFLAKE_RELATIONSHIP_FACTS_TABLE}
        SNOWFLAKE_RAG_DOCUMENTS_TABLE: ${SNOWFLAKE_RAG_DOCUMENTS_TABLE}
        SNOWFLAKE_RAG_SEARCH_SERVICE: ${SNOWFLAKE_RAG_SEARCH_SERVICE}
        SNOWFLAKE_AGENT_ORCHESTRATION_MODEL: ${SNOWFLAKE_AGENT_ORCHESTRATION_MODEL}
        SNOWFLAKE_CONVERSATION_SEGMENTS_TABLE: ${SNOWFLAKE_CONVERSATION_SEGMENTS_TABLE}
        SNOWFLAKE_AGENT_ARTIFACT_STAGE: ${SNOWFLAKE_AGENT_ARTIFACT_STAGE}
        AGENT_INLINE_ARTIFACT_LIMIT_BYTES: "${AGENT_INLINE_ARTIFACT_LIMIT_BYTES}"
        AGENT_ARTIFACT_DRAFT_RETENTION_DAYS: "${AGENT_ARTIFACT_DRAFT_RETENTION_DAYS}"
        AGENT_CONTEXT_LIMIT_TOKENS: "${AGENT_CONTEXT_LIMIT_TOKENS}"
        AGENT_THREAD_ROLLOVER_RATIO: "${AGENT_THREAD_ROLLOVER_RATIO}"
        AGENT_THREAD_HARD_RATIO: "${AGENT_THREAD_HARD_RATIO}"
        AGENT_RECENT_TURNS_TO_KEEP: "${AGENT_RECENT_TURNS_TO_KEEP}"
        AGENT_MAX_TURNS_PER_SEGMENT: "${AGENT_MAX_TURNS_PER_SEGMENT}"
        PREPARED_WORKSPACE_CONTEXT_V2: "${PREPARED_WORKSPACE_CONTEXT_V2}"
        ASSISTANT_STREAMING_V2: "${ASSISTANT_STREAMING_V2}"
        FIR_TARGET_MAPPING_PATTERNS_V2: "${FIR_TARGET_MAPPING_PATTERNS_V2}"
        FIR_DOCUMENT_LINEAGE_V3: "${FIR_DOCUMENT_LINEAGE_V3}"
        FIR_DURABLE_JOBS_V2: "${FIR_DURABLE_JOBS_V2}"
        PREPARED_CONTEXT_L1_IDLE_SECONDS: "${PREPARED_CONTEXT_L1_IDLE_SECONDS}"
        PREPARED_CONTEXT_SOFT_REVALIDATE_SECONDS: "${PREPARED_CONTEXT_SOFT_REVALIDATE_SECONDS}"
        PREPARED_CONTEXT_CLEANUP_DAYS: "${PREPARED_CONTEXT_CLEANUP_DAYS}"
        PREPARED_CONTEXT_DEBOUNCE_MS: "${PREPARED_CONTEXT_DEBOUNCE_MS}"
        SNOWFLAKE_PREPARED_WORKSPACE_CONTEXTS_TABLE: ${SNOWFLAKE_PREPARED_WORKSPACE_CONTEXTS_TABLE}
        SNOWFLAKE_TARGET_MAPPING_PATTERNS_TABLE: ${SNOWFLAKE_TARGET_MAPPING_PATTERNS_TABLE}
        SNOWFLAKE_FIR_LEARNING_JOBS_TABLE: ${SNOWFLAKE_FIR_LEARNING_JOBS_TABLE}
        SNOWFLAKE_FIR_LEARNING_WORK_ITEMS_TABLE: ${SNOWFLAKE_FIR_LEARNING_WORK_ITEMS_TABLE}
        FIR_PIPELINE_ENABLED: "${FIR_PIPELINE_ENABLED}"
        FIR_AGENT_PROCESSING_ENABLED: "${FIR_AGENT_PROCESSING_ENABLED}"
        FIR_CATCHUP_SCHEDULE_CRON: "${FIR_CATCHUP_SCHEDULE_CRON}"
        FIR_AGENT_REQUEST_TIMEOUT_SECONDS: "${FIR_AGENT_REQUEST_TIMEOUT_SECONDS}"
        FIR_AGENT_MAX_ASSETS_PER_RUN: "${FIR_AGENT_MAX_ASSETS_PER_RUN}"
        FIR_AGENT_MAX_PATTERNS_PER_BATCH: "${FIR_AGENT_MAX_PATTERNS_PER_BATCH}"
        FIR_AGENT_MAX_CONCURRENCY: "${FIR_AGENT_MAX_CONCURRENCY}"
        FIR_AGENT_RETRY_LIMIT: "${FIR_AGENT_RETRY_LIMIT}"
        FIR_PROCESS_UPLOADS_IMMEDIATELY: "${FIR_PROCESS_UPLOADS_IMMEDIATELY}"
        FIR_AGENT_DAILY_REQUEST_LIMIT: "${FIR_AGENT_DAILY_REQUEST_LIMIT}"
        FIR_AGENT_DAILY_TOKEN_LIMIT: "${FIR_AGENT_DAILY_TOKEN_LIMIT}"
        FIR_JOB_MAX_RUNTIME_SECONDS: "${FIR_JOB_MAX_RUNTIME_SECONDS}"
        SNOWFLAKE_OAUTH_AUTHORIZE_URL: ${SNOWFLAKE_OAUTH_AUTHORIZE_URL}
        SNOWFLAKE_OAUTH_TOKEN_URL: ${SNOWFLAKE_OAUTH_TOKEN_URL}
        SNOWFLAKE_OAUTH_SCOPE: ${SNOWFLAKE_OAUTH_SCOPE}
        SNOWFLAKE_SESSION_RETRY_ATTEMPTS: "${SNOWFLAKE_SESSION_RETRY_ATTEMPTS}"
        SNOWFLAKE_SESSION_RETRY_BACKOFF_SECONDS: "${SNOWFLAKE_SESSION_RETRY_BACKOFF_SECONDS}"
        SNOWFLAKE_USER_SESSION_CACHE_TTL_SECONDS: "${SNOWFLAKE_USER_SESSION_CACHE_TTL_SECONDS}"
        SNOWFLAKE_AGENT_RETRY_ATTEMPTS: "${SNOWFLAKE_AGENT_RETRY_ATTEMPTS}"
        SNOWFLAKE_AGENT_RETRY_BACKOFF_SECONDS: "${SNOWFLAKE_AGENT_RETRY_BACKOFF_SECONDS}"
        AUTO_MAPPING_WORKER_MAX_CONCURRENCY: "${AUTO_MAPPING_WORKER_MAX_CONCURRENCY}"
      resources:
        requests:
          cpu: "1"
          memory: "2Gi"
        limits:
          cpu: "2"
          memory: "4Gi"
      readinessProbe:
        port: 8000
        path: /health

  endpoints:
    - name: api
      port: 8000
      public: false

capabilities:
  securityContext:
    executeAsCaller: true
    enableCustomCredentials: ${SPCS_ENABLE_CUSTOM_CREDENTIALS}

serviceRoles:
  - name: backend_access
    endpoints:
      - api
