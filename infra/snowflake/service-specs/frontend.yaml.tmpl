spec:
  containers:
    - name: frontend
      image: /${SNOWFLAKE_DATABASE_LOWER}/${SNOWFLAKE_SCHEMA_LOWER}/${SNOWFLAKE_IMAGE_REPOSITORY_LOWER}/frontend:${IMAGE_TAG}
      env:
        NODE_ENV: "production"
        PORT: "3000"
        HOSTNAME: "0.0.0.0"
        STTM_BUILDER_URL: ${STTM_BUILDER_URL}
      resources:
        requests:
          cpu: "0.5"
          memory: "1Gi"
        limits:
          cpu: "1"
          memory: "2Gi"
      readinessProbe:
        port: 3000

  endpoints:
    - name: frontend
      port: 3000
      public: true
