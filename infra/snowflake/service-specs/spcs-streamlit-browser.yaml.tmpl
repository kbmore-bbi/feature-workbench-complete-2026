spec:
  containers:
    - name: streamlit-demo
      image: /${SNOWFLAKE_DATABASE_LOWER}/${SNOWFLAKE_SCHEMA_LOWER}/${SNOWFLAKE_IMAGE_REPOSITORY_LOWER}/spcs-streamlit-browser:${IMAGE_TAG}
      env:
        DEMO_TITLE: ${DEMO_TITLE}
        SNOWFLAKE_ACCOUNT: ${SNOWFLAKE_ACCOUNT}
        SNOWFLAKE_HOST: ${SNOWFLAKE_HOST}
        SNOWFLAKE_WAREHOUSE: ${SNOWFLAKE_WAREHOUSE}
        SNOWFLAKE_DATABASE: ${SNOWFLAKE_DATABASE}
        SNOWFLAKE_SCHEMA: ${SNOWFLAKE_SCHEMA}
      resources:
        requests:
          cpu: "0.5"
          memory: "1Gi"
        limits:
          cpu: "1"
          memory: "2Gi"
      readinessProbe:
        port: 8501
        path: /_stcore/health

  endpoints:
    - name: app
      port: 8501
      public: true

capabilities:
  securityContext:
    executeAsCaller: true

serviceRoles:
  - name: browser_access
    endpoints:
      - app
