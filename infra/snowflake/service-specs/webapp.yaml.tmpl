spec:
  containers:
    - name: sttm-builder
      image: /${SNOWFLAKE_DATABASE_LOWER}/${SNOWFLAKE_SCHEMA_LOWER}/${SNOWFLAKE_IMAGE_REPOSITORY_LOWER}/sttm-builder:${IMAGE_TAG}
      env:
        APP_NAME: ${APP_NAME}
        APP_ENV: ${APP_ENV}
        APP_VERSION: ${IMAGE_TAG}
        PORT: "8000"
        LOCAL_DEV_AUTH_ENABLED: "false"
        LOCAL_DEV_BYPASS_METADATA: "false"
        AUTH_MODE: ${AUTH_MODE}
        SPCS_EXECUTE_AS_CALLER_ENABLED: "${SPCS_EXECUTE_AS_CALLER_ENABLED}"
        USERS_TABLE: ${USERS_TABLE}
        SNOWFLAKE_OAUTH_SESSIONS_TABLE: ${SNOWFLAKE_OAUTH_SESSIONS_TABLE}
        APP_ROLE_ADMIN: ${APP_ROLE_ADMIN}
        APP_ROLE_PUBLISHER: ${APP_ROLE_PUBLISHER}
        APP_ROLE_VIEWER: ${APP_ROLE_VIEWER}
        AUTH_SESSION_COOKIE_NAME: ${AUTH_SESSION_COOKIE_NAME}
        AUTH_STATE_COOKIE_NAME: ${AUTH_STATE_COOKIE_NAME}
        AUTH_SESSION_COOKIE_SECURE: "${AUTH_SESSION_COOKIE_SECURE}"
        AUTH_SESSION_COOKIE_SAMESITE: "${AUTH_SESSION_COOKIE_SAMESITE}"
        AUTH_POST_LOGIN_REDIRECT_PATH: "${AUTH_POST_LOGIN_REDIRECT_PATH}"
        AUTH_POST_LOGOUT_REDIRECT_PATH: "${AUTH_POST_LOGOUT_REDIRECT_PATH}"
        SNOWFLAKE_OAUTH_AUTHORIZE_URL: "${SNOWFLAKE_OAUTH_AUTHORIZE_URL}"
        SNOWFLAKE_OAUTH_TOKEN_URL: "${SNOWFLAKE_OAUTH_TOKEN_URL}"
        SNOWFLAKE_OAUTH_REDIRECT_URI: "${SNOWFLAKE_OAUTH_REDIRECT_URI}"
        SNOWFLAKE_OAUTH_SCOPE: "${SNOWFLAKE_OAUTH_SCOPE}"
        SNOWFLAKE_WAREHOUSE: ${SNOWFLAKE_WAREHOUSE}
        SNOWFLAKE_CONTROL_WAREHOUSE: ${SNOWFLAKE_CONTROL_WAREHOUSE}
        SNOWFLAKE_AGENT_WAREHOUSE: ${SNOWFLAKE_AGENT_WAREHOUSE}
        SNOWFLAKE_EXECUTION_WAREHOUSE: ${SNOWFLAKE_EXECUTION_WAREHOUSE}
        SNOWFLAKE_PREPARATION_WAREHOUSE: "${SNOWFLAKE_PREPARATION_WAREHOUSE}"
        AUTO_MAPPING_WAREHOUSE: ${AUTO_MAPPING_WAREHOUSE}
        SNOWFLAKE_CONTROL_STATEMENT_TIMEOUT_SECONDS: "${SNOWFLAKE_CONTROL_STATEMENT_TIMEOUT_SECONDS}"
        SNOWFLAKE_AGENT_STATEMENT_TIMEOUT_SECONDS: "${SNOWFLAKE_AGENT_STATEMENT_TIMEOUT_SECONDS}"
        SNOWFLAKE_EXECUTION_STATEMENT_TIMEOUT_SECONDS: "${SNOWFLAKE_EXECUTION_STATEMENT_TIMEOUT_SECONDS}"
        SNOWFLAKE_PREPARATION_STATEMENT_TIMEOUT_SECONDS: "${SNOWFLAKE_PREPARATION_STATEMENT_TIMEOUT_SECONDS}"
        SNOWFLAKE_AUTOMAP_STATEMENT_TIMEOUT_SECONDS: "${SNOWFLAKE_AUTOMAP_STATEMENT_TIMEOUT_SECONDS}"
        SNOWFLAKE_SESSION_HEALTHCHECK_INTERVAL_SECONDS: "${SNOWFLAKE_SESSION_HEALTHCHECK_INTERVAL_SECONDS}"
        SNOWFLAKE_REST_HOST: ${SNOWFLAKE_REST_HOST}
        SNOWFLAKE_DATABASE: ${SNOWFLAKE_DATABASE}
        SNOWFLAKE_SCHEMA: ${SNOWFLAKE_SCHEMA}
        SNOWFLAKE_STTM_BUILDER_AGENT: ${SNOWFLAKE_STTM_BUILDER_AGENT}
        SNOWFLAKE_SOURCE_MAPPING_AGENT: ${SNOWFLAKE_SOURCE_MAPPING_AGENT}
        SNOWFLAKE_WORKBENCH_CONVERSATION_AGENT: ${SNOWFLAKE_WORKBENCH_CONVERSATION_AGENT}
        SNOWFLAKE_SEMANTIC_MODEL_AGENT: ${SNOWFLAKE_SEMANTIC_MODEL_AGENT}
        SNOWFLAKE_DBT_CONVERSION_AGENT: ${SNOWFLAKE_DBT_CONVERSION_AGENT}
        SNOWFLAKE_TEST_CASE_GENERATION_AGENT: ${SNOWFLAKE_TEST_CASE_GENERATION_AGENT}
        SNOWFLAKE_RELATIONSHIPS_PROCEDURE: ${SNOWFLAKE_RELATIONSHIPS_PROCEDURE}
        SNOWFLAKE_SEMANTIC_MODEL_TABLE: ${SNOWFLAKE_SEMANTIC_MODEL_TABLE}
        SNOWFLAKE_DERIVED_SOURCES_TABLE: ${SNOWFLAKE_DERIVED_SOURCES_TABLE}
        SNOWFLAKE_CONVERSATION_TURNS_TABLE: ${SNOWFLAKE_CONVERSATION_TURNS_TABLE}
        SNOWFLAKE_CONVERSATION_FEEDBACK_TABLE: ${SNOWFLAKE_CONVERSATION_FEEDBACK_TABLE}
        SNOWFLAKE_CONVERSATION_RECOMMENDATIONS_TABLE: ${SNOWFLAKE_CONVERSATION_RECOMMENDATIONS_TABLE}
        SNOWFLAKE_RELATIONSHIP_FACTS_TABLE: ${SNOWFLAKE_RELATIONSHIP_FACTS_TABLE}
        SNOWFLAKE_RAG_DOCUMENTS_TABLE: ${SNOWFLAKE_RAG_DOCUMENTS_TABLE}
        SNOWFLAKE_RAG_SEARCH_SERVICE: ${SNOWFLAKE_RAG_SEARCH_SERVICE}
        SNOWFLAKE_AGENT_ORCHESTRATION_MODEL: ${SNOWFLAKE_AGENT_ORCHESTRATION_MODEL}
        SNOWFLAKE_CONVERSATION_SEGMENTS_TABLE: ${SNOWFLAKE_CONVERSATION_SEGMENTS_TABLE}
        SNOWFLAKE_AGENT_ARTIFACT_STAGE: ${SNOWFLAKE_AGENT_ARTIFACT_STAGE}
        AGENT_INLINE_ARTIFACT_LIMIT_BYTES: "${AGENT_INLINE_ARTIFACT_LIMIT_BYTES}"
        AGENT_CALLER_INLINE_FALLBACK_LIMIT_BYTES: "${AGENT_CALLER_INLINE_FALLBACK_LIMIT_BYTES}"
        AGENT_ARTIFACT_DRAFT_RETENTION_DAYS: "${AGENT_ARTIFACT_DRAFT_RETENTION_DAYS}"
        AGENT_CONTEXT_LIMIT_TOKENS: "${AGENT_CONTEXT_LIMIT_TOKENS}"
        AGENT_THREAD_ROLLOVER_RATIO: "${AGENT_THREAD_ROLLOVER_RATIO}"
        AGENT_THREAD_HARD_RATIO: "${AGENT_THREAD_HARD_RATIO}"
        AGENT_RECENT_TURNS_TO_KEEP: "${AGENT_RECENT_TURNS_TO_KEEP}"
        AGENT_MAX_TURNS_PER_SEGMENT: "${AGENT_MAX_TURNS_PER_SEGMENT}"
        AGENT_PAYLOAD_BUDGET_V1: "${AGENT_PAYLOAD_BUDGET_V1}"
        AUTO_MAPPING_PAYLOAD_BUDGET_V1: "${AUTO_MAPPING_PAYLOAD_BUDGET_V1}"
        AGENT_OVERSIZE_RETRY_V1: "${AGENT_OVERSIZE_RETRY_V1}"
        AGENT_OUTBOUND_MESSAGE_MAX_CHARS: "${AGENT_OUTBOUND_MESSAGE_MAX_CHARS}"
        AGENT_OUTBOUND_MESSAGE_MAX_BYTES: "${AGENT_OUTBOUND_MESSAGE_MAX_BYTES}"
        AGENT_THREAD_CONTEXT_MAX_CHARS: "${AGENT_THREAD_CONTEXT_MAX_CHARS}"
        BACKEND_READ_CACHE_V1: "${BACKEND_READ_CACHE_V1}"
        BACKEND_PROJECT_SUMMARY_CACHE_SECONDS: "${BACKEND_PROJECT_SUMMARY_CACHE_SECONDS}"
        BACKEND_RECOMMENDATION_CACHE_SECONDS: "${BACKEND_RECOMMENDATION_CACHE_SECONDS}"
        STTM_SOURCE_BULK_WRITE_V1: "${STTM_SOURCE_BULK_WRITE_V1}"
        FIR_LEARNING_CONTEXT_ENABLED: "true"
        FIR_SIGNAL_BUS_ENABLED: "true"
        SNOWFLAKE_SEMANTIC_TABLE_VIEWS_TABLE: ${SNOWFLAKE_SEMANTIC_TABLE_VIEWS_TABLE}
        SNOWFLAKE_SEMANTIC_COLUMN_VIEWS_TABLE: ${SNOWFLAKE_SEMANTIC_COLUMN_VIEWS_TABLE}
        SNOWFLAKE_SEMANTIC_NATIVE_VIEWS_TABLE: ${SNOWFLAKE_SEMANTIC_NATIVE_VIEWS_TABLE}
        SNOWFLAKE_SEMANTIC_VIEWS_DATABASE: "${SNOWFLAKE_SEMANTIC_VIEWS_DATABASE}"
        SNOWFLAKE_SEMANTIC_VIEWS_SCHEMA: "${SNOWFLAKE_SEMANTIC_VIEWS_SCHEMA}"
        AUTO_MAPPING_SERVICE_URL: ${AUTO_MAPPING_SERVICE_URL}
        AUTO_MAPPING_SERVICE_TIMEOUT_SECONDS: "${AUTO_MAPPING_SERVICE_TIMEOUT_SECONDS}"
        AUTO_MAPPING_SERVICE_RETRY_ATTEMPTS: "${AUTO_MAPPING_SERVICE_RETRY_ATTEMPTS}"
        AUTO_MAPPING_PROXY_BATCH_SIZE: "${AUTO_MAPPING_PROXY_BATCH_SIZE}"
        AUTO_MAPPING_PROXY_MAX_IN_FLIGHT: "${AUTO_MAPPING_PROXY_MAX_IN_FLIGHT}"
        AUTO_MAP_PIPELINE_V2: "${AUTO_MAP_PIPELINE_V2}"
        PERF_DIAGNOSTICS_V1: "${PERF_DIAGNOSTICS_V1}"
        PREPARED_CONTEXT_CACHE_V2: "${PREPARED_CONTEXT_CACHE_V2}"
        CONTEXT_SINGLEFLIGHT_V1: "${CONTEXT_SINGLEFLIGHT_V1}"
        FIR_QUERY_PRUNING_V1: "${FIR_QUERY_PRUNING_V1}"
        TARGET_SCOPED_CACHE_INVALIDATION_V1: "${TARGET_SCOPED_CACHE_INVALIDATION_V1}"
        RELATIONSHIP_CAPABILITY_CACHE_V1: "${RELATIONSHIP_CAPABILITY_CACHE_V1}"
        RELATIONSHIP_PROC_FAST_GUARDS_V1: "${RELATIONSHIP_PROC_FAST_GUARDS_V1}"
        LOW_CONFIDENCE_JOIN_REVIEW_V1: "${LOW_CONFIDENCE_JOIN_REVIEW_V1}"
        CONVERSATION_MEMORY_V2: "${CONVERSATION_MEMORY_V2}"
        SNOWFLAKE_SESSION_LEASE_POOL_V1: "${SNOWFLAKE_SESSION_LEASE_POOL_V1}"
        LEARNING_PARALLEL_V1: "${LEARNING_PARALLEL_V1}"
        PREPARE_PARALLEL_V1: "${PREPARE_PARALLEL_V1}"
        AUTOSAVE_SINGLEFLIGHT_V1: "${AUTOSAVE_SINGLEFLIGHT_V1}"
        AUTOSAVE_POSTSAVE_ASYNC_V1: "${AUTOSAVE_POSTSAVE_ASYNC_V1}"
        PREPARATION_WAREHOUSE_ROUTING_V1: "${PREPARATION_WAREHOUSE_ROUTING_V1}"
        DURABLE_STTM_ROUTE_V1: "${DURABLE_STTM_ROUTE_V1}"
        AGENT_STREAM_BATCHING_V1: "${AGENT_STREAM_BATCHING_V1}"
        AGENT_SPEC_SOURCE_MAPPING_SHA256: "${AGENT_SPEC_SOURCE_MAPPING_SHA256}"
        AGENT_SPEC_TRANSFORMATION_RULE_SHA256: "${AGENT_SPEC_TRANSFORMATION_RULE_SHA256}"
        COCO_SERVICE_URL: "ws://127.0.0.1:8001/api/v1/coco/ws"
        SNOWFLAKE_SESSION_RETRY_ATTEMPTS: "${SNOWFLAKE_SESSION_RETRY_ATTEMPTS}"
        SNOWFLAKE_SESSION_RETRY_BACKOFF_SECONDS: "${SNOWFLAKE_SESSION_RETRY_BACKOFF_SECONDS}"
        SNOWFLAKE_USER_SESSION_CACHE_TTL_SECONDS: "${SNOWFLAKE_USER_SESSION_CACHE_TTL_SECONDS}"
        SNOWFLAKE_AGENT_RETRY_ATTEMPTS: "${SNOWFLAKE_AGENT_RETRY_ATTEMPTS}"
        SNOWFLAKE_AGENT_RETRY_BACKOFF_SECONDS: "${SNOWFLAKE_AGENT_RETRY_BACKOFF_SECONDS}"
        CORS_ALLOWED_ORIGINS: "${CORS_ALLOWED_ORIGINS}"
${SNOWFLAKE_OAUTH_SECRET_MAPPINGS}
      resources:
        requests:
          cpu: "0.5"
          memory: "1Gi"
        limits:
          cpu: "1"
          memory: "2Gi"
      readinessProbe:
        port: 8000
        path: /health

    # BEGIN COCO_SIDECAR
    - name: coco-agent
      image: /${SNOWFLAKE_DATABASE_LOWER}/${SNOWFLAKE_SCHEMA_LOWER}/${SNOWFLAKE_IMAGE_REPOSITORY_LOWER}/sttm-builder:${IMAGE_TAG}
      env:
        APP_MODULE: app.coco.main:app
        PORT: "8001"
        UVICORN_LOOP: asyncio
        COCO_ENABLED: "true"
        COCO_KNOWLEDGE_DIR: /app/knowledge
        COCO_WORKBENCH_API_URL: http://127.0.0.1:8000
        COCO_SNOWFLAKE_ACCOUNT: "${SNOWFLAKE_ACCOUNT}"
        COCO_SNOWFLAKE_WAREHOUSE: ${SNOWFLAKE_AGENT_WAREHOUSE}
        COCO_SNOWFLAKE_DATABASE: ${SNOWFLAKE_DATABASE}
        COCO_SNOWFLAKE_SCHEMA: ${SNOWFLAKE_SCHEMA}
        CORTEX_CODE_CLI_PATH: /root/.local/bin/cortex
      resources:
        requests:
          cpu: "0.5"
          memory: "1Gi"
        limits:
          cpu: "1"
          memory: "2Gi"
      readinessProbe:
        port: 8001
        path: /health
    # END COCO_SIDECAR

    - name: frontend
      image: /${SNOWFLAKE_DATABASE_LOWER}/${SNOWFLAKE_SCHEMA_LOWER}/${SNOWFLAKE_IMAGE_REPOSITORY_LOWER}/frontend:${IMAGE_TAG}
      env:
        NODE_ENV: production
        NEXT_PUBLIC_APP_ENV: ${APP_ENV}
        NEXT_PUBLIC_AGENT_STREAM_BATCHING_V1: "${AGENT_STREAM_BATCHING_V1}"
        NEXT_PUBLIC_DURABLE_STTM_ROUTE_V1: "${DURABLE_STTM_ROUTE_V1}"
        PORT: "3000"
      resources:
        requests:
          cpu: "0.5"
          memory: "1Gi"
        limits:
          cpu: "1"
          memory: "2Gi"
      readinessProbe:
        port: 3000

    - name: nginx
      image: /${SNOWFLAKE_DATABASE_LOWER}/${SNOWFLAKE_SCHEMA_LOWER}/${SNOWFLAKE_IMAGE_REPOSITORY_LOWER}/nginx:${IMAGE_TAG}
      env:
        FRONTEND_UPSTREAM: 127.0.0.1:3000
        BACKEND_UPSTREAM: 127.0.0.1:8000
      resources:
        requests:
          cpu: "0.25"
          memory: "512Mi"
        limits:
          cpu: "0.5"
          memory: "1Gi"
      readinessProbe:
        port: 8080

  endpoints:
    - name: app
      port: 8080
      public: true

capabilities:
  securityContext:
    executeAsCaller: ${SPCS_EXECUTE_AS_CALLER_ENABLED}
    enableCustomCredentials: ${SPCS_ENABLE_CUSTOM_CREDENTIALS}
