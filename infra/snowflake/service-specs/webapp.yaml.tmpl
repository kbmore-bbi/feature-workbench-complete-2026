spec:
  containers:
    - name: sttm-builder
      image: /${SNOWFLAKE_DATABASE_LOWER}/${SNOWFLAKE_SCHEMA_LOWER}/${SNOWFLAKE_IMAGE_REPOSITORY_LOWER}/sttm-builder:${IMAGE_TAG}
      env:
        APP_NAME: ${APP_NAME}
        APP_ENV: ${APP_ENV}
        APP_VERSION: ${IMAGE_TAG}
        PORT: "8000"
        USERS_TABLE: ${USERS_TABLE}
        APP_ROLE_ADMIN: ${APP_ROLE_ADMIN}
        APP_ROLE_PUBLISHER: ${APP_ROLE_PUBLISHER}
        APP_ROLE_VIEWER: ${APP_ROLE_VIEWER}
        SNOWFLAKE_ACCOUNT: ${SNOWFLAKE_ACCOUNT}
        SNOWFLAKE_HOST: ${SNOWFLAKE_HOST}
        SNOWFLAKE_WAREHOUSE: ${SNOWFLAKE_WAREHOUSE}
        SNOWFLAKE_DATABASE: ${SNOWFLAKE_DATABASE}
        SNOWFLAKE_SCHEMA: ${SNOWFLAKE_SCHEMA}
        SNOWFLAKE_STTM_BUILDER_AGENT: ${SNOWFLAKE_STTM_BUILDER_AGENT}
        SNOWFLAKE_SEMANTIC_MODEL_AGENT: ${SNOWFLAKE_SEMANTIC_MODEL_AGENT}
        SNOWFLAKE_RELATIONSHIPS_PROCEDURE: ${SNOWFLAKE_RELATIONSHIPS_PROCEDURE}
        SNOWFLAKE_SEMANTIC_MODEL_TABLE: ${SNOWFLAKE_SEMANTIC_MODEL_TABLE}
        SNOWFLAKE_DERIVED_SOURCES_TABLE: ${SNOWFLAKE_DERIVED_SOURCES_TABLE}
        SNOWFLAKE_AGENT_ORCHESTRATION_MODEL: ${SNOWFLAKE_AGENT_ORCHESTRATION_MODEL}
        CORS_ALLOWED_ORIGINS: "${CORS_ALLOWED_ORIGINS}"
      resources:
        requests:
          cpu: "0.5"
          memory: "1Gi"
        limits:
          cpu: "1"
          memory: "2Gi"
      readinessProbe:
        port: 8000
        path: /health

    - name: frontend
      image: /${SNOWFLAKE_DATABASE_LOWER}/${SNOWFLAKE_SCHEMA_LOWER}/${SNOWFLAKE_IMAGE_REPOSITORY_LOWER}/frontend:${IMAGE_TAG}
      env:
        NODE_ENV: production
        NEXT_PUBLIC_APP_ENV: ${APP_ENV}
        PORT: "3000"
      resources:
        requests:
          cpu: "0.5"
          memory: "1Gi"
        limits:
          cpu: "1"
          memory: "2Gi"
      readinessProbe:
        port: 3000

    - name: nginx
      image: /${SNOWFLAKE_DATABASE_LOWER}/${SNOWFLAKE_SCHEMA_LOWER}/${SNOWFLAKE_IMAGE_REPOSITORY_LOWER}/nginx:${IMAGE_TAG}
      env:
        FRONTEND_UPSTREAM: 127.0.0.1:3000
        BACKEND_UPSTREAM: 127.0.0.1:8000
      resources:
        requests:
          cpu: "0.25"
          memory: "512Mi"
        limits:
          cpu: "0.5"
          memory: "1Gi"
      readinessProbe:
        port: 8080

  endpoints:
    - name: app
      port: 8080
      public: true

capabilities:
  securityContext:
    executeAsCaller: true
