SNOWFLAKE_ACCOUNT=your_org-your_account
# Optional. Leave blank unless you explicitly need to override the default host.
SNOWFLAKE_HOST=
SNOWFLAKE_AUTHENTICATOR=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
AUTO_MAP_PIPELINE_V2=true
AGENT_SPEC_SOURCE_MAPPING_SHA256=b3a312d41aeff743a62522e7595098f9e61d9c0fd3735deb530feceb8cac91b3
AGENT_SPEC_TRANSFORMATION_RULE_SHA256=216ce641971e55b921462f26e117ec08479505d232f64bb1107fc926c3b4a999

SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=
# Workload routing. Set all four to the same X-Small to use one warehouse.
SNOWFLAKE_CONTROL_WAREHOUSE=
SNOWFLAKE_AGENT_WAREHOUSE=
SNOWFLAKE_EXECUTION_WAREHOUSE=
AUTO_MAPPING_WAREHOUSE=
SNOWFLAKE_CONTROL_STATEMENT_TIMEOUT_SECONDS=60
SNOWFLAKE_AGENT_STATEMENT_TIMEOUT_SECONDS=300
SNOWFLAKE_EXECUTION_STATEMENT_TIMEOUT_SECONDS=900
SNOWFLAKE_AUTOMAP_STATEMENT_TIMEOUT_SECONDS=600
SNOWFLAKE_SESSION_HEALTHCHECK_INTERVAL_SECONDS=0
USERS_TABLE=TBL_USERS
APP_ROLE_ADMIN=WORKBENCH_ADMIN
APP_ROLE_PUBLISHER=WORKBENCH_PUBLISHER
APP_ROLE_VIEWER=WORKBENCH_VIEWER

# Local-only auth fallback. Keep disabled for deployed SPCS environments.
LOCAL_DEV_AUTH_ENABLED=false
LOCAL_DEV_USER_EMAIL=
LOCAL_DEV_BYPASS_METADATA=true

# Authentication mode:
# - ingress_headers: existing local/dev connector flow
# - custom_oauth: Snowflake OAuth login through /api/v1/auth/login
AUTH_MODE=ingress_headers
SPCS_EXECUTE_AS_CALLER_ENABLED=true
SNOWFLAKE_OAUTH_SESSIONS_TABLE=TBL_WORKBENCH_OAUTH_SESSIONS
SNOWFLAKE_OAUTH_CLIENT_ID=
SNOWFLAKE_OAUTH_CLIENT_SECRET=
SNOWFLAKE_OAUTH_AUTHORIZE_URL=
SNOWFLAKE_OAUTH_TOKEN_URL=
SNOWFLAKE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
SNOWFLAKE_OAUTH_SCOPE=session:role-any
AUTH_SESSION_SECRET=
AUTH_SESSION_ENCRYPTION_KEY=
AUTH_SESSION_COOKIE_NAME=sttm_session
AUTH_STATE_COOKIE_NAME=sttm_oauth_state
AUTH_SESSION_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_SAMESITE=lax
AUTH_POST_LOGIN_REDIRECT_PATH=/dashboard
AUTH_POST_LOGOUT_REDIRECT_PATH=/home

# Cortex Agents
SNOWFLAKE_STTM_BUILDER_AGENT=DB.SCHEMA.AGT_STTM_BUILDER
SNOWFLAKE_SEMANTIC_MODEL_AGENT=FOCUS_DB_2.STTM_MCP.AGT_SEMANTIC_MODEL_V2
SNOWFLAKE_DBT_CONVERSION_AGENT=DB.SCHEMA.AGT_DBT_CONVERSION
SNOWFLAKE_WORKBENCH_CONVERSATION_AGENT=DB.SCHEMA.AGT_WORKBENCH_CONVERSATION
SNOWFLAKE_RELATIONSHIPS_PROCEDURE=DB.SCHEMA.SP_GET_TABLE_RELATIONSHIPS
SNOWFLAKE_SEMANTIC_MODEL_TABLE=DB.SCHEMA.TBL_SEMANTIC_MODELS
SNOWFLAKE_SEMANTIC_VIEWS_DATABASE=FOCUS_DB_2
SNOWFLAKE_SEMANTIC_VIEWS_SCHEMA=STTM_MCP
SNOWFLAKE_SEMANTIC_TABLE_VIEWS_TABLE=LATEST_TABLE_VIEWS
SNOWFLAKE_SEMANTIC_COLUMN_VIEWS_TABLE=LATEST_COLUMN_VIEWS
SNOWFLAKE_SEMANTIC_NATIVE_VIEWS_TABLE=LATEST_NATIVE_VIEWS
SNOWFLAKE_DERIVED_SOURCES_TABLE=DB.SCHEMA.TBL_DERIVED_SOURCES
SNOWFLAKE_AGENT_ORCHESTRATION_MODEL=claude-sonnet-4
SNOWFLAKE_CONVERSATION_SEGMENTS_TABLE=DB.SCHEMA.TBL_WORKBENCH_CONVERSATION_SEGMENTS
SNOWFLAKE_AGENT_ARTIFACT_STAGE=DB.SCHEMA.AI_WORKBENCH_ARTIFACTS
AGENT_INLINE_ARTIFACT_LIMIT_BYTES=32768
AGENT_ARTIFACT_DRAFT_RETENTION_DAYS=90
AGENT_CONTEXT_LIMIT_TOKENS=90000
AGENT_THREAD_ROLLOVER_RATIO=0.65
AGENT_THREAD_HARD_RATIO=0.80
AGENT_RECENT_TURNS_TO_KEEP=8
AGENT_MAX_TURNS_PER_SEGMENT=60

# Optional local/external DataHub enrichment.
DATAHUB_ENABLED=false
DATAHUB_GRAPHQL_URL=
DATAHUB_UI_URL=
DATAHUB_TOKEN=
DATAHUB_DATASET_ENV=PROD
DATAHUB_TIMEOUT_SECONDS=10

# Deployed SPCS traffic should arrive through Snowflake ingress and caller context.
# For local-only testing, set LOCAL_DEV_AUTH_ENABLED=true and either provide the
# Snowflake password above or use SNOWFLAKE_AUTHENTICATOR=externalbrowser. The
# backend will then connect directly as that developer and respect the Snowflake
# RBAC available to that identity.
# For local-only testing, allow the reverse proxy origin if needed.
CORS_ALLOWED_ORIGINS=http://localhost:8080
# FIR runtime retrieval and unified notification delivery
FIR_LEARNING_CONTEXT_ENABLED=true
FIR_SIGNAL_BUS_ENABLED=true
PREPARED_WORKSPACE_CONTEXT_V2=true
ASSISTANT_STREAMING_V2=true
FIR_TARGET_MAPPING_PATTERNS_V2=true
FIR_DOCUMENT_LINEAGE_V3=true
FIR_DURABLE_JOBS_V2=true
PREPARED_CONTEXT_L1_IDLE_SECONDS=3600
PREPARED_CONTEXT_SOFT_REVALIDATE_SECONDS=86400
PREPARED_CONTEXT_CLEANUP_DAYS=30
PREPARED_CONTEXT_DEBOUNCE_MS=750
SNOWFLAKE_PREPARED_WORKSPACE_CONTEXTS_TABLE=TBL_PREPARED_WORKSPACE_CONTEXTS
SNOWFLAKE_TARGET_MAPPING_PATTERNS_TABLE=TBL_FIR_TARGET_MAPPING_PATTERNS
SNOWFLAKE_FIR_LEARNING_JOBS_TABLE=TBL_FIR_LEARNING_JOBS
SNOWFLAKE_FIR_LEARNING_WORK_ITEMS_TABLE=TBL_FIR_LEARNING_WORK_ITEMS
FIR_AGENT_REQUEST_TIMEOUT_SECONDS=840
FIR_AGENT_MAX_ASSETS_PER_RUN=1
FIR_AGENT_MAX_PATTERNS_PER_BATCH=10
FIR_AGENT_MAX_CONCURRENCY=2
FIR_AGENT_RETRY_LIMIT=2
FIR_PROCESS_UPLOADS_IMMEDIATELY=true
FIR_UPLOAD_EXPLANATIONS_ENABLED=true
FIR_UPLOAD_EXPLANATION_MODEL=claude-haiku-4-5
FIR_JOB_MAX_RUNTIME_SECONDS=3600
SNOWFLAKE_PROJECT_ATTRIBUTES_TABLE=TBL_PROJECT_ATTRIBUTES
